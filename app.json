{
  "expo": {
    "name": "Scan NFC-e",
    "slug": "ScanNFCe",
    "version": "2.0.0",
    "orientation": "portrait",
    "assetBundlePatterns": [
      "**/*"
    ],
    "scheme": "scannfce",
    "userInterfaceStyle": "light",
    "android": {
      "package": "com.scannfce",
      "versionCode": 2,
      "edgeToEdgeEnabled": true,
      "permissions": [
        "CAMERA",
        "INTERNET",
        "VIBRATE"
      ],
      "adaptiveIcon": {
        "foregroundImage": "./assets/icon.png",
        "backgroundColor": "#0A0D1C"
      }
    },
    "ios": {
      "bundleIdentifier": "com.scannfce",
      "buildNumber": "2.0.0"
    },
    "icon": "./assets/icon.png",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#0A0D1C"
    },
    "plugins": [
      [
        "expo-camera",
        {
          "cameraPermission": "Permita que o Scan NFC-e acesse a câmera para ler o QR Code da nota.",
          "barcodeScannerEnabled": true
        }
      ],
      [
        "expo-secure-store",
        {
          "configureAndroidBackup": true,
          "faceIDPermission": "Permita que o Scan NFC-e use o Face ID para proteger sua sessão."
        }
      ]
    ]
  }
}
